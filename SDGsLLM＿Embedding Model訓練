:["訓練損失: 0.3251\n","驗證文本損失: 0.9793\n","驗證QA損失: 0.0000\n","驗證總損失: 0.2938\n","開始第 2/3 輪訓練\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"0fa814bedf134740a99b010fb1d15ffc","version_major":2,"version_minor":0},"text/plain":["Epoch 2:   0%|          | 0/142 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"output_type":"stream","name":"stdout","text":["訓練損失: 0.3026\n","驗證文本損失: 0.9312\n","驗證QA損失: 0.0001\n","驗證總損失: 0.2794\n","開始第 3/3 輪訓練\n"]},{"output_type":"display_data","data":{"text/plain":["Epoch 3:   0%|          | 0/142 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9a48a1b3328c43cab27e09fb9798295d"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["訓練損失: 0.2650\n","驗證文本損失: 0.7903\n","驗證QA損失: 0.0000\n","驗證總損失: 0.2371\n","評估模型在QA排序任務上的性能...\n"]},{"output_type":"display_data","data":{"text/plain":["評估QA排序:   0%|          | 0/125 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c08da897df2a4c85887fb9e4d4186273"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["QA排序準確率: 100.00%\n"]}],"source":["# 7. 初始化模型和優化器\n","embedding_model = EmbeddingModel(model, tokenizer, num_labels=len(label_mapping)).to(device)\n","optimizer = torch.optim.AdamW(embedding_model.parameters(), lr=2e-5)\n","\n","# 8. 訓練循環\n","num_epochs = 3\n","# 設定權重，問答集比較重要，所以設比較大\n","text_weight = 0.3  # 普通文本損失的權重\n","triplet_weight = 0.7  # 三元組損失的權重\n","\n","embedding_model.train()\n","for epoch in range(num_epochs):\n","    print(f\"開始第 {epoch+1}/{num_epochs} 輪訓練\")\n","    total_loss = 0\n","\n","    # 使用較短的數據加載器來決定每個 epoch 的步數\n","    steps_per_epoch = min(len(train_dataloader), len(train_qa_dataloader))\n","    train_iter = iter(train_dataloader)\n","    train_qa_iter = iter(train_qa_dataloader)\n","\n","    progress_bar = tqdm(range(steps_per_epoch), desc=f\"Epoch {epoch+1}\")\n","    for _ in progress_bar:\n","        # 獲取兩種批次數據\n","        try:\n","            batch = next(train_iter)\n","        except StopIteration:\n","            train_iter = iter(train_dataloader)\n","            batch = next(train_iter)\n","\n","        try:\n","            qa_batch = next(train_qa_iter)\n","        except StopIteration:\n","            train_qa_iter = iter(train_qa_dataloader)\n","            qa_batch = next(train_qa_iter)\n","\n","        # 清零梯度\n","        optimizer.zero_grad()\n","\n","        # 計算普通文本分類損失\n","        input_ids = batch['input_ids'].to(device)\n","        attention_mask = batch['attention_mask'].to(device)\n","        labels = batch['label'].to(device)\n","\n","        # 使用修改後的 forward 方法\n","        text_outputs = embedding_model(input_ids, attention_mask, labels)\n","        text_loss = text_outputs['loss']\n","\n","        # 計算三元組損失 - 使用 forward_triplet 方法\n","        q_input_ids = qa_batch['q_input_ids'].to(device)\n","        q_attention_mask = qa_batch['q_attention_mask'].to(device)\n","        pos_input_ids = qa_batch['pos_input_ids'].to(device)\n","        pos_attention_mask = qa_batch['pos_attention_mask'].to(device)\n","        neg_input_ids = qa_batch['neg_input_ids'].to(device)\n","        neg_attention_mask = qa_batch['neg_attention_mask'].to(device)\n","\n","        # 使用修改後的 forward_triplet 方法\n","        qa_outputs = embedding_model.forward_triplet(\n","            q_input_ids, q_attention_mask,\n","            pos_input_ids, pos_attention_mask,\n","            neg_input_ids, neg_attention_mask\n","        )\n","        qa_loss = qa_outputs['loss']\n","\n","        # 結合兩種損失\n","        loss = text_weight * text_loss + triplet_weight * qa_loss\n","\n","        # 反向傳播\n","        loss.backward()\n","\n","        # 更新參數\n","        optimizer.step()\n","\n","        total_loss += loss.item()\n","        progress_bar.set_postfix({'loss': loss.item(), 'text_loss': text_loss.item(), 'qa_loss': qa_loss.item()})\n","\n","    avg_loss = total_loss / steps_per_epoch\n","    print(f\"訓練損失: {avg_loss:.4f}\")\n","\n","    # 驗證\n","    embedding_model.eval()\n","    val_text_loss = 0\n","    val_qa_loss = 0\n","\n","    with torch.no_grad():\n","        # 驗證文本損失\n","        for batch in val_dataloader:\n","            input_ids = batch['input_ids'].to(device)\n","            attention_mask = batch['attention_mask'].to(device)\n","            labels = batch['label'].to(device)\n","\n","            text_outputs = embedding_model(input_ids, attention_mask, labels)\n","            val_text_loss += text_outputs['loss'].item()\n","\n","        # 驗證QA損失\n","        for batch in val_qa_dataloader:\n","            q_input_ids = batch['q_input_ids'].to(device)\n","            q_attention_mask = batch['q_attention_mask'].to(device)\n","            pos_input_ids = batch['pos_input_ids'].to(device)\n","            pos_attention_mask = batch['pos_attention_mask'].to(device)\n","            neg_input_ids = batch['neg_input_ids'].to(device)\n","            neg_attention_mask = batch['neg_attention_mask'].to(device)\n","\n","            qa_outputs = embedding_model.forward_triplet(\n","                q_input_ids, q_attention_mask,\n","                pos_input_ids, pos_attention_mask,\n","                neg_input_ids, neg_attention_mask\n","            )\n","            val_qa_loss += qa_outputs['loss'].item()\n","\n","    avg_val_text_loss = val_text_loss / len(val_dataloader)\n","    avg_val_qa_loss = val_qa_loss / len(val_qa_dataloader)\n","    avg_val_total_loss = text_weight * avg_val_text_loss + triplet_weight * avg_val_qa_loss\n","\n","    print(f\"驗證文本損失: {avg_val_text_loss:.4f}\")\n","    print(f\"驗證QA損失: {avg_val_qa_loss:.4f}\")\n","    print(f\"驗證總損失: {avg_val_total_loss:.4f}\")\n","\n","    embedding_model.train()\n","\n","# 9. 評估QA性能\n","def evaluate_qa_ranking(model, eval_qa_dataloader, device):\n","    model.eval()\n","    correct = 0\n","    total = 0\n","\n","    with torch.no_grad():\n","        for batch in tqdm(eval_qa_dataloader, desc=\"評估QA排序\"):\n","            q_input_ids = batch['q_input_ids'].to(device)\n","            q_attention_mask = batch['q_attention_mask'].to(device)\n","            pos_input_ids = batch['pos_input_ids'].to(device)\n","            pos_attention_mask = batch['pos_attention_mask'].to(device)\n","            neg_input_ids = batch['neg_input_ids'].to(device)\n","            neg_attention_mask = batch['neg_attention_mask'].to(device)\n","\n","            # 獲取嵌入\n","            q_embeddings = model.get_embeddings(q_input_ids, q_attention_mask)\n","            pos_embeddings = model.get_embeddings(pos_input_ids, pos_attention_mask)\n","            neg_embeddings = model.get_embeddings(neg_input_ids, neg_attention_mask)\n","\n","            # 計算相似度\n","            pos_sim = torch.nn.functional.cosine_similarity(q_embeddings, pos_embeddings)\n","            neg_sim = torch.nn.functional.cosine_similarity(q_embeddings, neg_embeddings)\n","\n","            # 檢查正確排序\n","            correct += (pos_sim > neg_sim).sum().item()\n","            total += len(q_embeddings)\n","\n","    accuracy = correct / total * 100\n","    return {'accuracy': accuracy}\n","\n","print(\"評估模型在QA排序任務上的性能...\")\n","qa_performance = evaluate_qa_ranking(embedding_model, val_qa_dataloader, device)\n","print(f\"QA排序準確率: {qa_performance['accuracy']:.2f}%\")"]},{"cell_type":"markdown","source":["儲存模型"],"metadata":{"id":"ZspoiN2wZrci"}},{"cell_type":"code","source":["output_dir = '/content/drive/MyDrive/永續實驗室/sustainability_embedding_model'\n","os.makedirs(output_dir, exist_ok=True)\n","\n","# 儲存整個模型（包含架構和權重）\n","torch.save(embedding_model, os.path.join(output_dir, \"full_model.pt\"))\n","torch.save(embedding_model.state_dict(), os.path.join(output_dir, \"model_weights.pt\"))\n","\n","# 同時儲存 tokenizer 以便使用\n","embedding_model.tokenizer.save_pretrained(output_dir)\n","\n","print(f\"模型已保存到 {output_dir}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yghU_6QHZrLD","execution