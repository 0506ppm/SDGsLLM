ecution_count":5,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"lNVn6oyvaSer"},"source":["定義兩種資料集的class"]},{"cell_type":"code","source":["# 文字資料的class\n","class TextDataset(Dataset):\n","    def __init__(self, texts, tokenizer, max_length=512):\n","        self.texts = texts\n","        self.tokenizer = tokenizer\n","        self.max_length = max_length\n","\n","    def __len__(self):\n","        return len(self.texts)\n","\n","    def __getitem__(self, idx):\n","        text = self.texts[idx]\n","\n","        # 將文本從文字轉成數字序列，透過BERT的voc表，把文字轉成唯一的ID（tokenizing）\n","        # 之後的詞向量模型，再將這個ID轉成向量 （embedding）\n","        encoding = self.tokenizer(\n","            text,\n","            max_length=self.max_length,\n","            padding='max_length',\n","            truncation=True,\n","            return_tensors='pt'\n","        )\n","\n","        return {k: v.squeeze(0) for k, v in encoding.items()}"],"metadata":{"id":"PWrOMqBh5oAF","executionInfo":{"status":"ok","timestamp":1745923756139,"user_tz":-480,"elapsed":1,"user":{"displayName":"李淳澔","userId":"17049967129279531511"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","execution_count":7,"metadata":{"id":"DiDrU7EkaMVY","executionInfo":{"status":"ok","timestamp":1745923756552,"user_tz":-480,"elapsed":7,"user":{"displayName":"李淳澔","userId":"17049967129279531511"}}},"outputs":[],"source":["# QA數據集\n","class QATripletDataset(Dataset):\n","    def __init__(self, qa_triples, tokenizer, max_length=512):\n","        self.qa_triples = qa_triples\n","        self.tokenizer = tokenizer\n","        self.max_length = max_length\n","\n","    def __len__(self):\n","        return len(self.qa_triples)\n","\n","    def __getitem__(self, idx):\n","        qa_item = self.qa_triples[idx]\n","        question = clean_text(qa_item['question'])\n","        pos_answer = clean_text(qa_item['positive answer'])\n","        neg_answer = clean_text(qa_item['negative answer'])\n","\n","        q_encoding = self.tokenizer(\n","            question,\n","            max_length=self.max_length,\n","            padding='max_length',\n","            truncation=True,\n","            return_tensors='pt'\n","        )\n","\n","        pos_encoding = self.tokenizer(\n","            pos_answer,\n","            max_length=self.max_length,\n","            padding='max_length',\n","            truncation=True,\n","            return_tensors='pt'\n","        )\n","\n","        neg_encoding = self.tokenizer(\n","            neg_answer,\n","            max_length=self.max_length,\n","            padding='max_length',\n","            truncation=True,\n","            return_tensors='pt'\n","        )\n","\n","        # 把 tokenizer 自動提供的張量刪除\n","        return {\n","            'q_input_ids': q_encoding['input_ids'].squeeze(0),\n","            'q_attention_mask': q_encoding['attention_mask'].squeeze(0),\n","            'pos_input_ids': pos_encoding['input_ids'].squeeze(0),\n","            'pos_attention_mask': pos_encoding['attention_mask'].squeeze(0),\n","            'neg_input_ids': neg_encoding['input_ids'].squeeze(0),\n","            'neg_attention_mask': neg_encoding['attention_mask'].squeeze(0)\n","        }"]},{"cell_type":"markdown","metadata":{"id":"V5SHa6F8YE0x"},"source":["將資料集切成batch"]},{"cell_type":"code","execution_count":8,"metadata":{"id":"dL5We5oBYJ98","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1745923759418,"user_tz":-480,"elapsed":41,"user":{"displayName":"李淳澔","userId":"17049967129279531511"}},"outputId":"0bd0f42d-f57d-4ca8-e100-c78d4a2813fb"},"outputs":[{"output_type":"stream","name":"stdout","text":["從 初級做法_texts.txt 讀取了 781 個文檔\n","從 進階做法_texts.txt 讀取了 898 個文檔\n","從 領先做法_texts.txt 讀取了 274 個文檔\n","清理和組合後得到 1415 個文本段落\n","訓練數據: 1132文本, 4000QA對\n","驗證數據: 283文本, 1000QA對\n"]}],"source":["# 4. 分割數據並創建 DataLoader\n","# 對於有標籤的文本數據，我們需要同時分割文本和標籤\n","texts, labels = load_text_with_labels()  # 確保先獲取文本和標籤\n","cleaned_texts = [clean_text(text) for text in texts]\n","\n","# 如果你需要合併段落，同時保留標籤信息\n","def combine_texts_into_paragraphs_with_labels(texts, labels, max_length=128):\n","    paragraphs = []\n","    paragraph_labels = []\n","    current_paragraph = \"\"\n","    current_label = None\n","\n","    for i, text in enumerate(texts):\n","        if not text.strip():\n","            continue\n","\n","        if current_label is None:\n","            current_label = labels[i]\n","\n","        # 僅當標籤相同時合併文本\n","        if len(current_paragraph) + len(text) < max_length and current_label == labels[i]:\n","            current_paragraph += text + \" \"\n","        else:\n","            if current_paragraph:\n","                paragraphs.append(current_paragraph.strip())\n","                paragraph_labels.append(current_label)\n","            current_paragraph = text + \" \"\n","            current_label = labels[i]\n","\n","    if current_paragraph:\n","        paragraphs.append(current_paragraph.strip())\n","        paragraph_labels.append(current_label)\n","\n","    return paragraphs, paragraph_labels\n","\n","# 合併文本並保留標籤\n","paragraphs, paragraph_labels = combine_texts_into_paragraphs_with_labels(cleaned_texts, labels)\n","print(f\"清理和組合後得到 {len(paragraphs)} 個文本段落\")\n","\n","# 分割數據\n","train_texts, val_texts, train_labels, val_labels = train_test_split(\n","    paragraphs, paragraph_labels, test_size=0.2, random_state=42)\n","\n","# 使用 LabeledTextDataset 而不是 TextDataset\n","train_dataset = LabeledTextDataset(train_texts, train_labels, tokenizer)\n","val_dataset = LabeledTextDataset(val_texts, val_labels, tokenizer)\n","\n","# QA對數據\n","train_qa_triples, val_qa_triples = train_test_split(qa_pairs, test_size=0.2, random_state=42)\n","train_qa_dataset = QATripletDataset(train_qa_triples, tokenizer)\n","val_qa_dataset = QATripletDataset(val_qa_triples, tokenizer)\n","\n","# DataLoader的作用：將數據集根據指定的長度（batch_size），分割成特定的大小\n","batch_size = 8\n","train_dataloader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)\n","val_dataloader = DataLoader(val_dataset, batch_size=batch_size)\n","train_qa_dataloader = DataLoader(train_qa_dataset, batch_size=batch_size, shuffle=True)\n","val_qa_dataloader = DataLoader(val_qa_dataset, batch_size=batch_size)\n","\n","print(f\"訓練數據: {len(train_texts)}文本, {len(train_qa_triples)}QA對\")\n","print(f\"驗證數據: {len(val_texts)}文本, {len(val_qa_triples)}QA對\")"]},{"cell_type":"markdown","metadata":{"id":"TWmfijOxYMe5"},"source":["定義模型類別"]},{"cell_type":"code","execution_count":9,"metadata":{"id":"oRSCdM3kYQHu","executionInfo":{"status":"ok","timestamp":1745923762439,"user_tz":-480,"elapsed":2,"user":{"displayName":"李淳澔","userId":"17049967129279531511"}}},"outputs":[],"source":["class EmbeddingModel(torch.nn.Module):\n","    def __init__(self, base_model, tokenizer, num_labels=3):\n","        super(EmbeddingModel, self).__init__()\n","        self.model = base_model\n","        self.tokenizer = tokenizer\n","        self.classifier = torch.nn.Linear(base_model.config.hidden_size, num_labels)\n","\n","    def get_embeddings(self, input_ids, attention_mask):\n","        outputs = self.model(input_ids=input_ids, attention_mask=attention_mask)\n","        token_embeddings = outputs.last_hidden_state\n","\n","        # 平均池化 - 將每個詞的向量組合起來取平均，變成代表整個句子的向量\n","        extended_attention_mask = attention_mask.unsqueeze(-1)\n","        sum_embeddings = torch.sum(token_embeddings * extended_attention_mask, 1)\n","        sum_mask = torch.sum(extended_attention_mask, 1)\n","        sum_mask = torch.clamp(sum_mask, min=1e-9)\n","        pooled_embeddings = sum_embeddings / sum_mask\n","\n","        return pooled_embeddings\n","\n","    def forward(self, input_ids, attention_mask, labels=None):\n","        # 獲取文本嵌入\n","        embeddings = self.get_embeddings(input_ids, attention_mask)\n","\n","        # 分類任務\n","        if labels is not None:\n","            logits = self.classifier(embeddings)\n","            loss_fct = torch.nn.CrossEntropyLoss()\n","            loss = loss_fct(logits, labels)\n","            return {'loss': loss, 'logits': logits, 'embeddings': embeddings}\n","\n","        return {'embeddings': embeddings}\n","\n","    def forward_triplet(self, q_input_ids, q_attention_mask,\n","                        pos_input_ids, pos_attention_mask,\n","                        neg_input_ids, neg_attention_mask):\n","        # 獲取問題、正面答案和負面答案的嵌入\n","        q_emb = self.get_embeddings(q_input_ids, q_attention_mask)\n","        pos_emb = self.get_embeddings(pos_input_ids, pos_attention_mask)\n","        neg_emb = self.get_embeddings(neg_input_ids, neg_attention_mask)\n","\n","        # 計算三元組損失\n","        margin = 0.5\n","        pos_score = torch.sum(q_emb * pos_emb, dim=1)\n","        neg_score = torch.sum(q_emb * neg_emb, dim=1)\n","\n","        # 三元組損失: 確保正例比負例的得分高出至少margin\n","        triplet_loss = torch.nn.functional.relu(margin - pos_score + neg_score).mean()\n","\n","        return {\n","            'loss': triplet_loss,\n","            'q_embeddings': q_emb,\n","            'pos_embeddings': pos_emb,\n","            'neg_embeddings': neg_emb\n","        }\n","\n","    # 最後被用來向量化的函數\n","    def get_embedding(self, text, device):\n","        inputs = self.tokenizer(\n","            text,\n","            max_length=512,\n","            padding='max_length',\n","            truncation=True,\n","            return_tensors='pt'\n","        ).to(device)\n","\n","        with torch.no_grad():\n","            embedding = self.get_embeddings(\n","                input_ids=inputs['input_ids'],\n","                attention_mask=inputs['attention_mask']\n","            )\n","\n","        return embedding"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":449,"referenced_widgets":["b2d2002dfe3344dda79fa7433a69ca98","1f50f2f1599947c8b75fdc7c2c54b5ea","0cdb3af72643430a83c4d2ccc996e1c3","99e308c6d85b4ec69f28977a7d813d71","cd7b46e064ee46f7af0fb4721f81ff96","97f54944