_passages = []\n","    rating_summaries = []\n","\n","    label_map = {\n","        0: \"初級做法\",\n","        1: \"進階做法\",\n","        2: \"領先做法\"\n","    }\n","\n","    for rank, idx in enumerate(I[0]):\n","        para_id = paragraph_ids[idx]\n","        doc = collection.find_one({\"_id\": para_id})\n","\n","        label_index = doc.get(\"label\", -1)\n","        label_text = label_map.get(label_index, \"未標記\")\n","\n","        context_passages.append(f\"[{label_text}] {doc['text']}\")\n","        rating_summaries.append(f\"Top {rank+1}: {label_text}\")\n","\n","    context = \"\\n\".join(context_passages)\n","    ratings = \"\\n\".join(rating_summaries)\n","\n","    prompt = f\"\"\"你是一位熟悉永續報告書的助理，請根據以下段落內容，詳細用繁體中文回答問題。\n","---\n","{context}\n","---\n","問題：{query_text}\n","\"\"\"\n","\n","    # ✅ 用本地 pipeline 生成回答\n","    response = llm_pipe(\n","        prompt,\n","        max_new_tokens=512,\n","        temperature=0.7,\n","        top_p=0.9\n","    )[0][\"generated_text\"]\n","\n","    # ✅ 顯示結果\n","    print(f\"🔍 問題：{query_text}\\n\")\n","    print(\"📚 查詢段落：\\n\" + context)\n","    print(\"🏷️ 來源評級：\\n\" + ratings)\n","    print(\"\\n🤖 Fine-tuned LLM 回答：\\n\" + response)\n"],"metadata":{"id":"Bths_IIwMh1y","executionInfo":{"status":"error","timestamp":1745925554385,"user_tz":-480,"elapsed":877,"user":{"displayName":"李淳澔","userId":"17049967129279531511"}},"colab":{"base_uri":"https://localhost:8080/","height":598},"outputId":"b88b6d02-36b4-4561-a6e7-c23de1ba19a8"},"execution_count":28,"outputs":[{"output_type":"error","ename":"ImportError","evalue":"Using `bitsandbytes` 4-bit quantization requires the latest version of bitsandbytes: `pip install -U bitsandbytes`","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mImportError\u001b[0m                               Traceback (most recent call last)","\u001b[0;32m<ipython-input-28-8878c7edc0bc>\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34