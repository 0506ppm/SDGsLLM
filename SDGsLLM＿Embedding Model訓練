         continue\n","\n","        try:\n","            with open(file_path, 'r', encoding='utf-8') as f:\n","                content = f.read()\n","\n","                # 切分文件內容（假設每個文檔之間有明確的分隔符）\n","                # 如果文件是每行一個文檔，可以使用以下方式\n","                documents = content.split(\"\\n\\n\")  # 使用空行分隔文檔\n","\n","                # 過濾空文檔\n","                documents = [doc.strip() for doc in documents if doc.strip()]\n","\n","                print(f\"從 {filename} 讀取了 {len(documents)} 個文檔\")\n","\n","                # 為每個文檔添加相應的標籤\n","                all_texts.extend(documents)\n","                all_labels.extend([label_mapping[category]] * len(documents))\n","        except Exception as e:\n","            print(f\"讀取檔案 {file_path} 時出錯: {e}\")\n","\n","    return all_texts, all_labels\n","\n","    return all_texts, all_labels\n","\n","# 文本清理函數\n","def clean_text(text):\n","    text = re.sub(r'\\s+', ' ', text)\n","    text = re.sub(r'[^\\w\\s\\u4e00-\\u9fff，。？！：；（）、\"\"''「」『』《》〈〉.,:;!?\"\\'()[\\]{}\\-—]', '', text)\n","    return text.strip()\n","\n","texts, labels = load_text_with_labels()\n","print(f\"加載了 {len(texts)} 個帶標記的文本\")\n","\n","# 清理文本\n","cleaned_texts = [clean_text(text) for text in texts]\n","\n","# 加載 QA 對數據\n","with open('/content/drive/MyDrive/企業永續報告書LLM/qa_pairs.json', 'r', encoding='utf-8') as f:\n","    qa_pairs = json.load(f)\n","print(f\"加載了 {len(qa_pairs)} 個 QA 對\")"]},{"cell_type":"markdown","metadata":{"id":"Wk_KohmlXpH0"},"source":["資料前處理"]},{"cell_type":"markdown","metadata":{"id":"-aM3u0jdXtLh"},"source":["載入模型"]},{"cell_type":"code","execution_count":4,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":304,"referenced_widgets":["7d892887213e44908501cb48a5d5922d","a97df28440b34e86aba5cbe55f004714","ae2c8eec36764fd6aa735aff1093adc4","3d891ade2aec40c29b15bef5c60848b9","f91a01bd89e8489286670d84b7edec1e","c601c5f15e3d477bb9cdd2d8e1f2aed0","75e916dafb3e4879bef4c41ff535886e","fcc232f2dbe64ebca495bc13c1d7a777","9831d79fbb484f