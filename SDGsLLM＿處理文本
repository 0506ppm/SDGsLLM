data)\n","    print(f\"總共讀取了 {len(text_content)} 個文件\")\n","\n","    if not os.path.exists(output_folder):\n","        os.makedirs(output_folder)\n","\n","    for category in folders:\n","        category_texts = text_content[text_content['category'] == category]\n","        if not category_texts.empty:\n","            output_file = os.path.join(output_folder, f\"{category}_texts.txt\")\n","            with open(output_file, 'w', encoding='utf-8') as f:\n","                for _, row in category_texts.iterrows():\n","                    f.write(f\"===== 文件: {row['source']} =====\\n\")\n","                    f.write(row['content'])\n","                    f.write(\"\\n\\n\")\n","            print(f\"已保存 {category} 類別的 {len(category_texts)} 個文件到 {output_file}\")"],"metadata":{"id":"j-BZsYuKuoko","executionInfo":{"status":"ok","timestamp":1746502221301,"user_tz":-480,"elapsed":14,"user":{"displayName":"李淳澔","userId":"17049967129279531511"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["def read_and_save_seperate_txt(base_path, folders, output_folder):\n","    # 讀取所有資料夾中的文檔\n","    all_text_data = []\n","    for folder in folders:\n","        folder_path = os.path.join(base_path, folder)\n","        print(f\"開始處理資料夾: {folder_path}\")\n","        texts = read_documents_from_folder(folder_path, folder)\n","        all_text_data.extend(texts)\n","        print(f\"從 {folder} 資料夾讀取了 {len(texts)} 個文件\")\n","\n","    # 將所有文本轉換成 DataFrame\n","    text_content = pd.DataFrame(all_text_data)\n","    print(f\"總共讀取了 {len(text_content)} 個文件\")\n","\n","    if not os.path.exists(output_folder):\n","        os.makedirs(output_folder)\n","\n","    # 為每個文件單獨創建一個txt檔\n","    for _, row in text_content.iterrows():\n","        category = row['category']\n","        # 從source中提取檔案名稱，避免路徑字符問題\n","        file_name = os.path.basename(row['source'])\n","        # 去除副檔名並加上新的副檔名\n","        file_name_without_ext = os.path.splitext(file_name)[0]\n","\n","        # 確保該類別的子資料夾存在